# 仅用于海外版或旧版兼容流程；大陆版账号模式不再需要 ACCESS_CODE。
ACCESS_CODE=
OPENAI_API_KEY=
APP_REGION=cn
AUTH_PROVIDER=cn-dev
APP_MODE=development
HOST=127.0.0.1
PORT=4185
XINLING_DATA_DIR=
SETTINGS_PROVIDER=file
ADMIN_SETTINGS_CODE=
# Legacy only: ADMIN_SETTINGS_CODE is no longer used by the mainland admin account flow.
CN_ADMIN_INIT_CODE=
CN_SESSION_SECRET=
CN_SESSION_EXPIRES_DAYS=7
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ADMIN_INIT_CODE=your_admin_init_code

MODEL_PIPELINE=split
ANALYSIS_MODE=legacy_dual_model
MULTIMODAL_PROVIDER=qwen
MULTIMODAL_MODEL=qwen3.8-max
# 正式多模态分析超时，单位毫秒；允许范围 30000-600000。
MODEL_ANALYSIS_TIMEOUT_MS=240000

SINGLE_PROVIDER=openai
SINGLE_MODEL=gpt-4o-mini

VISION_PROVIDER=openai
VISION_MODEL=gpt-4o-mini

TEXT_PROVIDER=openai
TEXT_MODEL=gpt-4o-mini

# Recommended mainland defaults can be set through the admin UI and are saved in SQLite.
# API keys must stay in .env.local or server environment variables only.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_TEXT_MODEL=
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_VISION_MODEL=
QWEN_MULTIMODAL_MODEL=qwen3.8-max
# QWEN_BASE_URL 请按阿里云百炼控制台或官方文档填写 OpenAI 兼容地址（例如 compatible-mode/v1 形式）。
# 不要把真实 QWEN_API_KEY 提交到 GitHub。

DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_VISION_MODEL=

MODEL_PROVIDER=
QIANFAN_API_KEY=
DOMESTIC_DATABASE_URL=

# 填写说明：请只填写自己的本地 .env.local 或服务器环境变量，不要把真实密钥提交到 GitHub。
# 大陆版准备阶段暂未启用 DEEPSEEK_API_KEY、QIANFAN_API_KEY、DOMESTIC_DATABASE_URL 等国内模型和数据库变量。
# Legacy only: ACCESS_CODE is no longer used by the mainland account login flow.
